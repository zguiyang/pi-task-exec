{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "cli/**/*.ts",
    "mcp/**/*.ts"
  ],
  "exclude": [
    "tests",
    "dist",
    "node_modules"
  ]
}
