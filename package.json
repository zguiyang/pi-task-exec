{
  "name": "@zguiyang/pi-task-exec",
  "version": "0.1.1",
  "mcpName": "io.github.zguiyang/pi-task-exec",
  "description": "A host-agnostic MCP worker runtime for supervising local Pi coding-agent processes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-task-exec": "./mcp/dist/index.js"
  },
  "files": [
    "mcp/dist/**",
    "skills/pi-delegate/**",
    "README.md",
    "mcp/README.md",
    "LICENSE",
    "mcp/LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p mcp/tsconfig.json",
    "typecheck": "tsc --noEmit -p mcp/tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 mcp/tests/*.test.mjs",
    "prepack": "npm run build",
    "start": "node mcp/dist/index.js mcp serve"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
