{
  "name": "@zguiyang/pi-worker-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.zguiyang/pi-worker-mcp",
  "description": "A host-agnostic MCP worker runtime for supervising local Pi coding-agent processes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-worker-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build",
    "start": "node dist/index.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
